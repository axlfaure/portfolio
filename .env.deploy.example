# Connexion au serveur, pour `npm run deploy`, `npm run backup` et
# `npm run rollback`.
#
# Copier ce fichier en `.env.deploy` et renseigner les deux valeurs. Le
# fichier réel est exclu du dépôt : il désigne un serveur, il n'a rien à y
# faire.
#
# Les deux valeurs se lisent dans le Manager Infomaniak, rubrique SSH, et
# correspondent à ce que vous saisissez dans la console web.

# Identifiant de connexion, sous la forme utilisateur@serveur
DEPLOY_SSH=

# Chemin absolu du site sur le serveur, celui qui contient package.json
DEPLOY_PATH=
